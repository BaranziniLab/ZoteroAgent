{
  "name": "zoteroagent",
  "display_name": "ZoteroAgent",
  "description": "MCP adapter for Zotero libraries, collections, items, tags, and citation metadata with read-first and mutation-gated API access.",
  "version": "0.1.0",
  "entry_point": "zoteroagent",
  "repository": "https://github.com/BaranziniLab/ZoteroAgent",
  "license": "Apache-2.0",
  "tools_count": 6,
  "env_vars": [
    {
      "key": "ZOTERO_API_KEY",
