      "auto_propagate": false,
      "description": "Optional Zotero API key",
      "secret": true
    },
    {
      "key": "ZOTERO_USER_ID",
      "required": false,
      "auto_propagate": true,
      "description": "Optional Zotero user id",
      "secret": false
    },
    {
      "key": "ZOTERO_GROUP_ID",
      "required": false,
      "auto_propagate": true,
      "description": "Optional Zotero group id",
      "secret": false
    },
    {
      "key": "ZOTERO_LOG_LEVEL",
      "required": false,
      "auto_propagate": true,
      "description": "Logging level",
      "secret": false,
      "default": "INFO"
    }
  ],
  "skills": [
    {
      "name": "zotero-citation-library",
